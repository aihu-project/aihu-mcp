{
  "name": "@aihu/mcp",
  "version": "0.2.1",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "serve": "./dist/bin/serve.js"
  },
  "files": [
    "dist",
    "src/cookbook-index.json",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bun run generate:cookbook && rolldown -c",
    "generate:cookbook": "bun scripts/build-cookbook-index.ts",
    "check:cookbook": "bun run generate:cookbook && git diff --exit-code -- src/cookbook-index.json llms-cookbook.txt",
    "check:release-version": "bun scripts/check-release-version.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:cookbook": "bun run cookbook/harness.ts",
    "check:ci": "bunx biome ci . && bun run typecheck && bun run test && bun run test:cookbook && bun run check:cookbook && bun run build && npm pack --dry-run",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@aihu/compiler": "^1.3.6",
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "description": "MCP server for aihu — exposes aihu_example and aihu_validate tools via stdio transport.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aihu-project/aihu-mcp.git"
  },
  "homepage": "https://github.com/aihu-project/aihu-mcp#readme",
  "bugs": "https://github.com/aihu-project/aihu-mcp/issues",
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=20.18.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@types/node": "^20.16.5",
    "rolldown": "^1.0.0-rc.17",
    "rolldown-plugin-dts": "^0.23.2",
    "typescript": "^5.6.2",
    "vitest": "^3.2.6"
  },
  "publishConfig": {
    "access": "public"
  }
}
